# 이 파일을 복사해 같은 폴더에 .env를 만들고 비밀번호를 채운다. .env는 깃에 올라가지 않는다.
# docker compose와 Spring Boot가 이 값을 같이 읽는다.
# Spring Boot가 properties 형식으로 읽기 때문에 따옴표 없이 KEY=VALUE로 쓴다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whattoeat
DB_USERNAME=whattoeat
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 참여자 쿠키를 HTTPS 연결에서만 보낼지 정한다. 로컬(http)은 false, 배포(https)는 true.
COOKIE_SECURE=false
